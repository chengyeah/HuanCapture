<?xml version="1.0" encoding="utf-8"?><androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:layout_width="match_parent"    android:layout_height="match_parent">    <Button        android:id="@+id/btn_search_device"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="搜索设备"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toTopOf="parent" />    <Button        android:id="@+id/btn_push_camera"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="推摄像头"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toBottomOf="@id/btn_search_device" />    <Button        android:id="@+id/btn_switch_camera"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="翻转"        app:layout_constraintLeft_toRightOf="@id/btn_push_camera"        app:layout_constraintTop_toBottomOf="@id/btn_search_device" />    <Button        android:id="@+id/btn_push_screen"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="推录屏"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toBottomOf="@id/btn_push_camera" />    <Button        android:id="@+id/btn_push_yuv_video"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="推视频"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toBottomOf="@id/btn_push_screen" />    <Button        android:id="@+id/btn_stop"        android:layout_width="wrap_content"        android:layout_height="wrap_content"        android:onClick="onButtonClicked"        android:text="停止推流"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toBottomOf="@id/btn_push_yuv_video" />    <org.webrtc.SurfaceViewRenderer        android:id="@+id/localView"        android:layout_width="match_parent"        android:layout_height="0dp"        app:layout_constraintLeft_toLeftOf="parent"        app:layout_constraintTop_toBottomOf="@id/btn_stop"        app:layout_constraintBottom_toBottomOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>